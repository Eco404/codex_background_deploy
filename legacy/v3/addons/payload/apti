#!/usr/bin/env bash
set -uo pipefail
ROOT="$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")"
LIST="$ROOT/packages.txt"
LOCKED=0
cleanup() { [ "$LOCKED" = 0 ] || rmdir -- "$ROOT/.package-lock" 2>/dev/null || true; }
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
root_run() { if [ "$(id -u)" = 0 ]; then "$@"; else command -v sudo >/dev/null && sudo -n "$@"; fi; }
valid() { [[ "$1" =~ ^[a-z0-9][a-z0-9+.-]*(:[a-z0-9-]+)?$ ]]; }
fail() { printf 'apti: %s\n' "$*" >&2; return 1; }
main() {
  local action="${1:-}" pkg tmp
  case "$action" in list) cat "$LIST"; return $?;; -h|--help|'') printf '用法：apti [install] <包名...> | list | forget <包名...> | restore\n'; return 0;; install|forget|restore) shift;; *) action=install;; esac
  local packages=()
  if [ "$action" = restore ]; then
    while IFS= read -r pkg; do
      [ -n "$pkg" ] || continue
      valid "$pkg" || { fail "清单中有无效包名：$pkg"; return 1; }
      dpkg-query -W -f='${Status}' "$pkg" 2>/dev/null | grep -Fq 'install ok installed' || packages+=("$pkg")
    done < "$LIST"
    [ "${#packages[@]}" -gt 0 ] || return 0
  else
    [ "$#" -gt 0 ] || { fail '缺少包名。'; return 2; }
    for pkg in "$@"; do valid "$pkg" || { fail "只接受标准包名（不接受选项或版本表达式）：$pkg"; return 2; }; packages+=("$pkg"); done
  fi
  mkdir "$ROOT/.package-lock" 2>/dev/null || { fail '另一个 apti 操作尚未结束。'; return 1; }
  LOCKED=1
  if [ "$action" != forget ]; then
    root_run apt-get -o DPkg::Lock::Timeout=60 -o Acquire::Retries=2 -o Acquire::http::Timeout=30 -o Acquire::https::Timeout=30 update || return
    root_run /usr/bin/env DEBIAN_FRONTEND=noninteractive apt-get -o DPkg::Lock::Timeout=60 install -y -- "${packages[@]}" || return
  fi
  [ "$action" != restore ] || return 0
  tmp="$(mktemp "$ROOT/packages.XXXXXX")" || return
  if [ "$action" = forget ]; then
    cp -- "$LIST" "$tmp" || { rm -f "$tmp"; return 1; }
    for pkg in "${packages[@]}"; do
      awk -v omit="$pkg" '$0 != omit' "$tmp" > "$tmp.next" && mv -- "$tmp.next" "$tmp" || { rm -f "$tmp" "$tmp.next"; return 1; }
    done
  else
    { cat "$LIST"; printf '%s\n' "${packages[@]}"; } | LC_ALL=C sort -u > "$tmp" || { rm -f "$tmp"; return 1; }
  fi
  mv -- "$tmp" "$LIST"
}
main "$@"
